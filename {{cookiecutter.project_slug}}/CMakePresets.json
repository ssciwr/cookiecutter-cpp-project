{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
{% if cookiecutter.doxygen == "Yes" or cookiecutter.readthedocs == "Yes" -%}
        "{{ cookiecutter.project_slug }}_BUILD_DOCS": false,
{%- endif -%}
{%- if cookiecutter.python_bindings != "None" -%}
        "{{ cookiecutter.project_slug }}_BUILD_PYTHON": false,
{%- endif -%}
        "{{ cookiecutter.project_slug }}_BUILD_TESTING": false
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "documentation",
      "displayName": "Release build with documentation",
      "description": "Release build with Doxygen and Sphinx enabled",
      "inherits": "release",
      "cacheVariables": {
        "{{ cookiecutter.project_slug }}_BUILD_DOCS": true
      }
    },
    {
      "name": "test",
      "displayName": "Debug with tests",
      "description": "Debug build with the C++ test suite enabled",
      "inherits": "debug",
      "cacheVariables": {
        "{{ cookiecutter.project_slug }}_BUILD_TESTING": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "documentation",
      "configurePreset": "documentation",
      "targets": [
        "{{ cookiecutter.project_slug }}-sphinx-doc"
      ]
    },
    {
      "name": "test",
      "configurePreset": "test"
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
